# catppuccin-mocha ghostty colors — from catppuccin/ghostty (official)
#
# Same treatment as the other three flavours: the vendor's own ghostty file
# rather than the emitter's derivation. The 16 slots happen to be identical to
# the generated ones here, so the difference is the chrome the emitter has no
# opinion about -- cursor, split divider -- plus a darker selection.
#
#   cursor-color          rosewater, catppuccin's convention for the caret, and
#                         a colour the text itself never uses so it can't be
#                         mistaken for a character. 12.94:1 on the background.
#   cursor-text           crust. ghostty keeps the default block cursor, so
#                         unlike kitty (cursor_shape beam) this one is live.
#   selection-background  the vendor's own #353749 rather than surface2.
#   split-divider-color   surface0; the emitter emits no divider at all.
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #11111b
selection-background = #353749
selection-foreground = #cdd6f4
split-divider-color = #313244
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
