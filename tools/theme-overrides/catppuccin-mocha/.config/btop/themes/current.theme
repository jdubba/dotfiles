# catppuccin-mocha btop theme — tuned to match the bar and prompt
#
# Three departures from the generated version:
#   1. Structure gets a real ramp. The emitter mapped meter_bg, div_line and
#      inactive_fg all to surface2, so an unfilled meter, a divider and dimmed
#      text were the same tone. They now walk surface0/surface1/surface2
#      (1.30 / 1.79 / 2.45:1) -- all deliberately under 3:1, because structure
#      belongs behind the data.
#   2. The selection is green with the palette's darkest ink (11.03:1), the same
#      pairing walker's selected row uses -- "current thing" is green throughout
#      this theme. hi_fg, the highlighted shortcut letters, takes the pink the
#      bar's pills use (10.74:1), so both accents are present.
#   3. Box outlines lead with those two accents rather than blue, and net_box
#      moves off red -- red carries error semantics elsewhere in this theme
#      (the fail state in hyprlock, walker's error banner, the battery's
#      critical pill), so it should not also be ordinary chrome.
#
# The graph gradients are deliberately NOT realigned: their ordering is
# semantic, not decorative -- green->yellow->red means low->high load, and
# recolouring that to the theme's two accents would destroy the reading.
theme[main_bg]="#1e1e2e"
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
# Pink, the accent the primary pills and the path pill share.
theme[hi_fg]="#f5c2e7"
# Green, matching walker's selected row.
theme[selected_bg]="#a6e3a1"
theme[selected_fg]="#1e1e2e"
theme[inactive_fg]="#585b70"
theme[graph_text]="#cdd6f4"
# surface0 — the quietest step of the structure ramp.
theme[meter_bg]="#313244"
theme[proc_misc]="#f5c2e7"
theme[cpu_box]="#f5c2e7"
theme[mem_box]="#a6e3a1"
# Was red; red is reserved for failure states in this theme.
theme[net_box]="#89b4fa"
theme[proc_box]="#94e2d5"
# surface1.
theme[div_line]="#45475a"
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"
theme[free_start]="#a6e3a1"
theme[free_mid]="#94e2d5"
theme[free_end]="#89b4fa"
theme[cached_start]="#94e2d5"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#f5c2e7"
theme[available_start]="#f9e2af"
theme[available_mid]="#f5c2e7"
theme[available_end]="#f38ba8"
theme[used_start]="#f9e2af"
theme[used_mid]="#f38ba8"
theme[used_end]="#f5c2e7"
theme[download_start]="#585b70"
theme[download_mid]="#94e2d5"
theme[download_end]="#89b4fa"
theme[upload_start]="#585b70"
theme[upload_mid]="#f5c2e7"
theme[upload_end]="#f38ba8"
theme[process_start]="#f9e2af"
theme[process_mid]="#a6e3a1"
theme[process_end]="#94e2d5"
