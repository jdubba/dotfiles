# solarized-light btop theme -- hand-tuned.
#
# Two changes off the generated version, both consequences of this being the
# light half of a pair whose accents are shared.
#
# main_fg was base00 #657b83 at 4.13:1 -- Solarized's body text is a
# deliberately soft slate on cream, which is right for prose and short of AA for
# a monitor's readouts. Ramped to #5d7178 (4.75), the same value the emitter
# already derives for this theme's waybar bar text.
#
# inactive_fg was base01 #586e75 at 4.99:1, i.e. as loud as body text, when it
# is chrome and belongs under 3. Solarized names the roles explicitly: secondary
# content is base01 in dark mode and base1 in light mode, and those two are an
# exact L* swap pair (45.0 <-> 65.2). So this is the SAME role as the dark
# theme's, following the ground -- #93a1a1 measures 1.86 here against 2.79 there.
theme[main_bg]="#fdf6e3"
theme[main_fg]="#5d7178"
theme[title]="#657b83"
theme[hi_fg]="#d33682"
theme[selected_bg]="#d33682"
theme[selected_fg]="#fdf6e3"
theme[inactive_fg]="#93a1a1"
theme[graph_text]="#657b83"
theme[meter_bg]="#eee8d5"
theme[proc_misc]="#268bd2"
theme[cpu_box]="#268bd2"
theme[mem_box]="#859900"
theme[net_box]="#dc322f"
theme[proc_box]="#2aa198"
theme[div_line]="#eee8d5"
theme[temp_start]="#859900"
theme[temp_mid]="#b58900"
theme[temp_end]="#dc322f"
theme[cpu_start]="#859900"
theme[cpu_mid]="#b58900"
theme[cpu_end]="#dc322f"
theme[free_start]="#859900"
theme[free_mid]="#2aa198"
theme[free_end]="#268bd2"
theme[cached_start]="#2aa198"
theme[cached_mid]="#268bd2"
theme[cached_end]="#d33682"
theme[available_start]="#dc322f"
theme[available_mid]="#b58900"
theme[available_end]="#859900"
theme[used_start]="#859900"
theme[used_mid]="#b58900"
theme[used_end]="#dc322f"
theme[download_start]="#eee8d5"
theme[download_mid]="#2aa198"
theme[download_end]="#268bd2"
theme[upload_start]="#eee8d5"
theme[upload_mid]="#d33682"
theme[upload_end]="#dc322f"
theme[process_start]="#b58900"
theme[process_mid]="#859900"
theme[process_end]="#2aa198"
