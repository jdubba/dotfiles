# gruvbox-light btop theme — tuned to match dotfiles palette
#
# Two departures from the generated version:
#   1. Structure was inverted. The emitter takes its neutral chrome from the
#      light-grey slot on light palettes, but gruvbox-light's slot 7 is #7c6f64
#      — a DARK grey — so meter_bg and div_line drew heavy dark bars across a
#      cream canvas (4.29:1, reading as data rather than chrome). They now use
#      the light bg1/bg2/bg3 ramp and properly recede.
#   2. Graphs use gruvbox's LIGHT-mode accent variants. The generated set is the
#      normal one, tuned for dark backgrounds: #d79921 is only 2.19:1 on
#      #fbf1c7, so rising meters faded out exactly where they matter. The
#      light-mode set (#9d0006, #79740e, #b57614, #076678, #8f3f71, #427b58) is
#      darker and reaches 3.3-7.6:1 here. Accent families are unchanged, so it
#      still matches the bar and prompt.
theme[main_bg]="#fbf1c7"
theme[main_fg]="#3c3836"
theme[title]="#3c3836"
# Blue accent, shared with the unified waybar pills and the prompt's path
# segment. Yellow is unusable as a foreground on this background (2.19:1).
theme[hi_fg]="#076678"
theme[selected_bg]="#076678"
theme[selected_fg]="#fbf1c7"
theme[inactive_fg]="#928374"
theme[graph_text]="#3c3836"
theme[meter_bg]="#d5c4a1"
theme[proc_misc]="#076678"
theme[cpu_box]="#076678"
theme[mem_box]="#427b58"
theme[net_box]="#8f3f71"
theme[proc_box]="#b57614"
theme[div_line]="#bdae93"
# Cool -> hot for anything where rising means worse.
theme[temp_start]="#79740e"
theme[temp_mid]="#b57614"
theme[temp_end]="#9d0006"
theme[cpu_start]="#79740e"
theme[cpu_mid]="#b57614"
theme[cpu_end]="#9d0006"
# Memory: more free/available trends cooler, more used trends hotter.
theme[free_start]="#79740e"
theme[free_mid]="#427b58"
theme[free_end]="#076678"
theme[cached_start]="#427b58"
theme[cached_mid]="#076678"
theme[cached_end]="#8f3f71"
theme[available_start]="#b57614"
theme[available_mid]="#79740e"
theme[available_end]="#427b58"
theme[used_start]="#79740e"
theme[used_mid]="#b57614"
theme[used_end]="#9d0006"
# Net: download cool, upload warm, both rising out of the bg3 structural tone.
theme[download_start]="#bdae93"
theme[download_mid]="#076678"
theme[download_end]="#427b58"
theme[upload_start]="#bdae93"
theme[upload_mid]="#8f3f71"
theme[upload_end]="#9d0006"
theme[process_start]="#b57614"
theme[process_mid]="#af3a03"
theme[process_end]="#9d0006"
