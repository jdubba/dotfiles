# gruvbox-dark btop theme — tuned to match dotfiles palette
#
# Two departures from the generated version:
#   1. Structure recedes. The emitter mapped meter_bg, div_line and inactive_fg
#      all to gruvbox gray #928374 (4.02:1 against main_bg), so every unfilled
#      meter and divider glowed. They now use the bg1/bg2/bg4 ramp, which is
#      deliberately low-contrast — structure should sit behind the data.
#   2. Graphs use gruvbox's BRIGHT accent variants, not the normal ones. On a
#      #282828 background the normal set (#458588, #98971a, #cc241d) sits at
#      3.2-3.5:1; the bright set reaches 5.4-8.7:1. Accent families are
#      unchanged, so it still matches the bar and prompt.
theme[main_bg]="#282828"
theme[main_fg]="#ebdbb2"
theme[title]="#ebdbb2"
# Yellow accent, shared with the waybar theme pill and the prompt's os segment.
theme[hi_fg]="#fabd2f"
theme[selected_bg]="#d79921"
theme[selected_fg]="#1d2021"
theme[inactive_fg]="#7c6f64"
theme[graph_text]="#ebdbb2"
theme[meter_bg]="#3c3836"
theme[proc_misc]="#83a598"
theme[cpu_box]="#83a598"
theme[mem_box]="#8ec07c"
theme[net_box]="#d3869b"
theme[proc_box]="#fabd2f"
theme[div_line]="#504945"
# Cool -> hot for anything where rising means worse.
theme[temp_start]="#b8bb26"
theme[temp_mid]="#fabd2f"
theme[temp_end]="#fb4934"
theme[cpu_start]="#b8bb26"
theme[cpu_mid]="#fabd2f"
theme[cpu_end]="#fb4934"
# Memory: more free/available trends cooler, more used trends hotter.
theme[free_start]="#b8bb26"
theme[free_mid]="#8ec07c"
theme[free_end]="#83a598"
theme[cached_start]="#8ec07c"
theme[cached_mid]="#83a598"
theme[cached_end]="#d3869b"
theme[available_start]="#d79921"
theme[available_mid]="#b8bb26"
theme[available_end]="#8ec07c"
theme[used_start]="#b8bb26"
theme[used_mid]="#fabd2f"
theme[used_end]="#fb4934"
# Net: download cool, upload warm, both rising out of the bg2 structural tone.
theme[download_start]="#504945"
theme[download_mid]="#83a598"
theme[download_end]="#8ec07c"
theme[upload_start]="#504945"
theme[upload_mid]="#d3869b"
theme[upload_end]="#fe8019"
theme[process_start]="#fabd2f"
theme[process_mid]="#fe8019"
theme[process_end]="#fb4934"
