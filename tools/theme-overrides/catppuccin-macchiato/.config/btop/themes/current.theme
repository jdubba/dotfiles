# catppuccin-macchiato btop theme — tuned to match the bar and prompt
#
# Three departures from the generated version:
#   1. Structure recedes in steps. The emitter gave inactive_fg, meter_bg and
#      div_line the SAME colour (#5b6078, 2.38:1), so an unfilled meter, a box
#      divider and an inactive label all drew at identical weight. They now use
#      the surface0/1/2 ramp (1.31 / 1.77 / 2.38:1) — deliberately below 3:1,
#      because structure belongs behind the data, but now layered rather than flat.
#   2. Three gradients ran backwards. available, used and process all trended
#      COOLER as they rose, so climbing CPU and filling memory read as calming.
#      Anything where rising means worse now warms; anything where rising means
#      better now cools.
#   3. The highlight is mauve, matching the active workspace dot in waybar. It is
#      the one accent the bar reserves for "this is the current thing".
#
# Accents are otherwise untouched: the box colours already matched the bar, and
# every one clears 3:1 on this background (5.96–10.20:1), so unlike gruvbox-dark
# there is no need to reach for brighter variants — catppuccin has none anyway.
theme[main_bg]="#24273a"
theme[main_fg]="#cad3f5"
theme[title]="#cad3f5"
# Mauve, shared with waybar's active workspace dot. selected_fg is crust rather
# than base: 8.09:1 against the mauve instead of 6.84:1, for free.
theme[hi_fg]="#c6a0f6"
theme[selected_bg]="#c6a0f6"
theme[selected_fg]="#181926"
# Structure, lightest of the three — inactive labels are still text you may glance
# at, so they sit above the meter fill and dividers.
theme[inactive_fg]="#5b6078"
theme[graph_text]="#cad3f5"
theme[meter_bg]="#363a4f"
theme[proc_misc]="#8aadf4"
# Box borders, unchanged: cpu periwinkle and mem sage are the prompt's directory
# and os pills, net rose is its connectors, proc teal is the waybar pill accent.
theme[cpu_box]="#8aadf4"
theme[mem_box]="#a6da95"
theme[net_box]="#ed8796"
theme[proc_box]="#8bd5ca"
theme[div_line]="#494d64"
# Rising means worse: sage -> yellow -> rose.
theme[temp_start]="#a6da95"
theme[temp_mid]="#eed49f"
theme[temp_end]="#ed8796"
theme[cpu_start]="#a6da95"
theme[cpu_mid]="#eed49f"
theme[cpu_end]="#ed8796"
# Memory. free and cached rise cool, because more of either is fine. available
# rises from warm to cool — it was yellow -> pink -> rose, i.e. plenty of free
# memory rendered as alarming. used is the only one that rises hot; it was
# yellow -> rose -> pink, which peaked in the middle and then cooled off.
theme[free_start]="#a6da95"
theme[free_mid]="#8bd5ca"
theme[free_end]="#8aadf4"
theme[cached_start]="#8bd5ca"
theme[cached_mid]="#8aadf4"
theme[cached_end]="#f5bde6"
theme[available_start]="#eed49f"
theme[available_mid]="#a6da95"
theme[available_end]="#8bd5ca"
theme[used_start]="#a6da95"
theme[used_mid]="#eed49f"
theme[used_end]="#ed8796"
# Net: download cool, upload warm, both rising out of the div_line tone so an
# idle graph reads as structure rather than as data.
theme[download_start]="#494d64"
theme[download_mid]="#8bd5ca"
theme[download_end]="#8aadf4"
theme[upload_start]="#494d64"
theme[upload_mid]="#f5bde6"
theme[upload_end]="#ed8796"
# Process list CPU%: same rising-means-worse ramp as cpu itself. It was
# yellow -> sage -> teal, so a process pinning a core cooled to teal.
theme[process_start]="#a6da95"
theme[process_mid]="#eed49f"
theme[process_end]="#ed8796"
