# catppuccin-macchiato ghostty colors — tuned to match the kitty seam
#
# The palette below is a verbatim copy of the emitter's output; a ghostty theme is
# one file, so this override pins it and a future registry change for this theme
# has to be mirrored here by hand.
#
# Three departures from the generated file, kept in step with the kitty seam:
#   1. selection-background moves from surface2 to surface1 -- selected text was
#      4.17:1, under AA, and reads 5.59:1 here.
#   2. cursor-color is rosewater, catppuccin's convention (the frappe and latte
#      vendor files in this directory both use it) and more visible than the
#      generated foreground at 11.18:1 against 9.92:1. cursor-text is crust,
#      13.23:1 on it.
#   3. split-divider-color, which the emitter does not emit at all, so ghostty fell
#      back to its default. surface0 at 1.31:1 against the background -- chrome
#      should recede, the same reasoning the btop theme uses.
#
# Note ghostty is included via `config-file = themes/current`, NOT `theme =
# current`: its gtk-single-instance daemon caches named themes and will not
# hot-reload when the file behind the name changes.
background = #24273a
foreground = #cad3f5
selection-background = #494d64
selection-foreground = #cad3f5
palette = 0=#494d64
palette = 1=#ed8796
palette = 2=#a6da95
palette = 3=#eed49f
palette = 4=#8aadf4
palette = 5=#f5bde6
palette = 6=#8bd5ca
palette = 7=#a5adcb
palette = 8=#5b6078
palette = 9=#ed8796
palette = 10=#a6da95
palette = 11=#eed49f
palette = 12=#8aadf4
palette = 13=#f5bde6
palette = 14=#8bd5ca
palette = 15=#b8c0e0
cursor-color = #f4dbd6
cursor-text = #181926
split-divider-color = #363a4f
