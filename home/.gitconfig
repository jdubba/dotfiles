[core]
    editor = nvim

[alias]
    st = status
    co = checkout
    d = difftool
    cm = commit -m  
    lg = lgn -n 15
    lgn = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an> %ae%Creset' --abbrev-commit

[init]
	defaultBranch = main

[include]
    path=~/.gitsigning

# Identity and commit signing are the per-machine parts of this file, so they
# live in the host layer: hosts/<host>/.config/git/identity supplies [user]
# name/email (work address on work machines, personal elsewhere) and, where the
# machine has a key, the signing key plus commit/tag.gpgsign. A signing key is
# selected by public fingerprint, which is not a secret, so it is committed --
# that keeps a host reproducible instead of depending on a hand-made local file.
# Listed AFTER ~/.gitsigning so the host layer wins over anything that file also
# sets; ~/.gitsigning remains the untracked escape hatch for values that must
# not be committed, and is still the mechanism on hosts with nothing tracked.
# A missing include is not an error in git, so a host without either file simply
# falls through to whatever git can infer, unsigned.
[include]
    path=~/.config/git/identity

# ...except in this repo, which is public and authored as jdubba regardless of
# which machine it is edited on. Last include wins, so this overrides the
# host identity above for the dotfiles working tree only.
[includeIf "gitdir:~/source/dotfiles/"]
    path=~/.config/git/identity-dotfiles

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[diff]
    tool = nvim

[difftool "nvim"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[merge]
    tool = nvim

[mergetool]
    prompt = false

[mergetool "nvim"]
    cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"

[pager]
	log = false
