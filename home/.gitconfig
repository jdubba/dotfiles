[core]
    editor = nvim

[alias]
    st = status
    co = checkout
    d = difftool
    cm = commit -m  
    lg = lgn -n 15
    lgn = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an> %ae%Creset' --abbrev-commit

[init]
	defaultBranch = main

[include]
    path=~/.gitsigning

# Identity is the only per-machine part of this file, so it lives in the host
# layer: hosts/<host>/.config/git/identity supplies [user] name/email (work
# address on work machines, personal elsewhere). Listed AFTER ~/.gitsigning so
# the host identity wins over any name/email that file also happens to set;
# .gitsigning remains the (untracked) home of the signing key.
# A missing include is not an error in git, so a host without the file simply
# falls through to whatever git can infer.
[include]
    path=~/.config/git/identity

# ...except in this repo, which is public and authored as jdubba regardless of
# which machine it is edited on. Last include wins, so this overrides the
# host identity above for the dotfiles working tree only.
[includeIf "gitdir:~/source/dotfiles/"]
    path=~/.config/git/identity-dotfiles

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[diff]
    tool = nvim

[difftool "nvim"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[merge]
    tool = nvim

[mergetool]
    prompt = false

[mergetool "nvim"]
    cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"

[pager]
	log = false
