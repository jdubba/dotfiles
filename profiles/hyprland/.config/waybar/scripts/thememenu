#!/usr/bin/env bash
#
# thememenu — Walker-based theme switcher for Waybar's custom/theme pill.
#
# Lists an "Auto theme" entry, a separator, then the predefined dotfiles themes
# (dotfiles theme list --plain). Auto theme opens a Walker-driven image browser
# and picking an image runs `dotfiles theme auto now <image>` (wallpaper-derived
# theme); selecting a named theme runs `dotfiles theme set <name>`. Both relink
# + live-reload.
#
# Bound from Waybar's custom/theme module on-click.

set -euo pipefail

# systemd --user (waybar.service) has a minimal PATH; ensure the launcher and
# the palette backend (wallust via ~/.cargo/bin) resolve.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

AUTO_LABEL="󰋩  Auto theme — pick an image…"

# Auto theme is pinned to the top: it is the one entry that is not a theme name
# but an action, and it used to sit at the bottom of a 40-item list where it
# scrolled off screen.
#
# Walker's dmenu has no separator primitive -- a list is lines of text -- so the
# rule below is an ordinary entry and is therefore selectable. main() loops on
# it rather than falling through, so a mis-click re-opens the menu instead of
# silently dismissing it. It carries no letters, so it drops out of the list as
# soon as the user types anything, which is exactly the wanted behaviour: it is
# a divider for the unfiltered list and nothing else.
#
# U+2500 BOX DRAWINGS LIGHT HORIZONTAL, deliberately NOT a Nerd Font PUA glyph
# -- those get hijacked by whichever installed font also covers the range (see
# AGENTS.md, Fonts). Every font in the stack has this one.
SEPARATOR="────────────────────────────────"

# --- Walker picker (matches the other waybar menu scripts) -------------------
# topright positions it just under Waybar's right side; -H hides the F1-F4
# quick-activate hints; -p sets the prompt.
menu() { walker -d -t topright -H -p "${1:-Select}"; }

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a "Theme" "$1" "${2:-}" || true
}

# First existing of the user's picture dirs, else $HOME.
_start_dir() {
  local d
  for d in "${XDG_PICTURES_DIR:-}" "$HOME/pictures/wallpapers" "$HOME/Pictures" "$HOME/pictures"; do
    [[ -n "$d" && -d "$d" ]] && { printf '%s' "$d"; return; }
  done
  printf '%s' "$HOME"
}

# Walker-driven image browser: navigate directories, return an absolute image
# path on stdout (empty / non-zero if cancelled).
pick_image() {
  local dir choice listing
  dir=$(_start_dir)
  while :; do
    listing=$(
      printf '..\n'
      find "$dir" -mindepth 1 -maxdepth 1 -type d -printf '%f/\n' 2>/dev/null | LC_ALL=C sort
      find "$dir" -mindepth 1 -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
           -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.gif' \) \
        -printf '%f\n' 2>/dev/null | LC_ALL=C sort
    )
    choice=$(printf '%s\n' "$listing" | menu "Image: ${dir/#$HOME/~}") || return 1
    [[ -n "$choice" ]] || return 1
    case "$choice" in
      "..") dir=$(dirname "$dir") ;;
      */)   dir="$dir/${choice%/}" ;;
      *)    printf '%s/%s' "$dir" "$choice"; return 0 ;;
    esac
  done
}

# Run a theme switch fully detached (new session). The switch reloads waybar
# (SIGUSR2) partway through its work; since this script is a child of waybar,
# a plain background job would be killed when waybar reloads — before it gets to
# reload the terminals (ghostty/kitty come after waybar in the reload order).
# setsid detaches it into its own session so it always runs to completion.
detached() {
  if command -v setsid >/dev/null 2>&1; then
    setsid -f "$@" >/dev/null 2>&1 </dev/null
  else
    ( "$@" >/dev/null 2>&1 </dev/null & disown ) 2>/dev/null
  fi
}

main() {
  local choice img
  while :; do
    choice=$( { printf '%s\n%s\n' "$AUTO_LABEL" "$SEPARATOR"
                dotfiles theme list --plain; } | menu "Theme" ) || exit 0
    [[ -n "$choice" ]] || exit 0
    [[ "$choice" == "$SEPARATOR" ]] || break
  done

  if [[ "$choice" == "$AUTO_LABEL" ]]; then
    img=$(pick_image) || exit 0
    [[ -n "$img" && -f "$img" ]] || exit 0
    notify "Auto theme" "Generating from $(basename "$img")…"
    detached dotfiles theme auto now "$img"
  else
    notify "Theme" "Switching to $choice…"
    detached dotfiles theme set "$choice"
  fi
}

main "$@"
